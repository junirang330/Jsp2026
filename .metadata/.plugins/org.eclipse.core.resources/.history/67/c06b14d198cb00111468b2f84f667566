<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import = "java.util.*" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>회원가입처리</title>
</head>
<body>
	<%
		/* 스크립트릿은 자바코드만 작성 가능하다. */
		request.setCharacterEncoding("utf-8");
		// Requestjoin.jsp의 입력된 정보를 Request 객체를 통해
		// 정보를 꺼내오세요.
		
		String id = request.getParameter("id");
		String pass = request.getParameter("pass");
		String passchk = request.getParameter("passchk");
		String email = request.getParameter("email");
		String tel = request.getParameter("tel");
		String[] hobby = request.getParameterValues("hobby");
		String job = request.getParameter("job");
		String age = request.getParameter("age");
		String info = request.getParameter("info");
		
		String msg = " ";
		/*
			비밀번호와 비밀번호체크가 같아야 회원가입 성공
			비밀번호와 비밀번호가 다르면 비밀번호가 틀립니다. 메시지 창 띄우기
		
			텍스트 입력창은 비워두고 제출하면 null이 아니고, ""(빈 문자열) 넘어오고,
			체크박스, 라디오 버튼은 선택하지 않으면 null로 넘어온다.
		*/
		
		if(id == null || id.isEmpty()){
			msg = "아이디를 입력하세요";
		}else if(pass == null || pass.isEmpty()){
			msg = "비밀번호를 입력하세요";
		}else if(passchk == null || passchk.isEmpty()){
			msg = "비밀번호를 확인을 입력하세요";
		}else if(!pass.equals(passchk)){
			msg = "비밀번호가 틀립니다.";
		}else if(email == null || email.isEmpty()){
			msg = "이메일을 입력하세요";
		}else if(tel == null || tel.isEmpty()){
			msg = "전화번호를 입력하세요";
		}else if(hobby == null || hobby.length==0){
			msg = "관심분야를 한개 이상 입력하세요";
		}else if(job == null || job.isEmpty()){
			msg = "직업을 선택하세요";
		}else if(age == null || age.isEmpty()){
			msg = "연령을 선택하세요";
		}
			
	%>
	<!-- 자바스크립트 객체 종류
		 1. 코어객체
		 2. DOM객체
		 3. BOM객체 ==> 브라우저에서 사용하는 객체
		 
		 	history객체는 브라우저가 현재 탭이나, 창에서 방문했던 웹페이지들의
		 	기록(Session History)을 관리하고 제어하는 객체이다.
		 	
		 	* history 객체의 메소드 종류
		 	 - history.back() : 바로 이전 페이지로 이동(뒤로 가기)
		 	 - history.forward() : 바로 다음 페이지로 이동(앞으로 가기)
		 	 - history.go(n) : 지정한 상대적 위치만큼 이동
		 	   - history.go(1) : 앞으로 가기
		 	   - history.go(0) : 현재 페이지
		 	   - hisotry.go(-1) : 뒤로 가기
	-->
	
	<script type ="text/javascript">
		alert(<%= msg %> );
		history.go(-1);
	</script>
	
	
		
	<table border= "1">
		<tr><th>구분</th><th>정보</th></tr>
		<tr height = "60">
			<td align = "center" width = "150">아이디</td>
			<td align = "center" width = "350"><%= id %>
			</td>
		</tr>
		<tr height = "60">
			<td align = "center" width = "150">이메일</td>
			<td align = "center" width = "350"><%= email %>
			</td>
		</tr>
		<tr height = "60">
			<td align = "center" width = "150">전화번호</td>
			<td align = "center" width = "350"><%= tel %>
			</td>
		</tr>
		<tr height = "60">
			<td align = "center" width = "150">취미</td>
			<td align = "center" width = "350">
				<% for(int i =0; i<hobby.length; i++){
				%>
				<%= hobby[i] %>
				<%
				   }
				%>
			</td>
		</tr>
		<tr height = "60">
			<td align = "center" width = "150">직업</td>
			<td align = "center" width = "350"><%= job %>
			</td>
		</tr>
		<tr height = "60">
			<td align = "center" width = "150">나이</td>
			<td align = "center" width = "350"><%= age %>
			</td>
		</tr>
		<tr height = "60">
			<td align = "center" width = "150">남긴말</td>
			<td align = "center" width = "350"><%= info %>
			</td>
		</tr>
	
	</table>

	
	

</body>
</html>