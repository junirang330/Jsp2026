<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import="java.util.*" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
</head>
<body>
	<h1>구구단 2단 ~ 9단까지 모두 출력할 것</h1>
	<table border = "1">
	<!-- 단 -->
	<tr>
	<% for(int i = 2; i<=9; i++){ %>
	<th>
	<%= i + "단" %>	
	</th>
	<% } %>
	</tr>
	
	<!-- 구구단  -->
	<% for(int j = 1; j<=9; j++){ %>
	<tr>
	<% for(int i = 2; i<=9; i++){ %>
		<td><%=i %> *<%=j %> = <%= i*j %></td>
	<% } %>
	</tr>
	<!-- </tr> -->
	<%	}	%>
	</table>
</body>
</html>