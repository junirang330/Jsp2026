<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8" import = "java.util.*" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>테스트04</title>
</head>
<body>
	<!-- 선언문 작성하는 방법 -->
	<!-- 선언문을 통해 작성한 메소드, 변수는 멤버메소드, 멤버변수가 된다. -->
	<%! public void inCremment(){}; %>
	<!-- 아래 선언문은 전역변수 또는 멤버변수 이다. -->
	<%! int i = 0; %>
	<!-- 아래 스크립트릿은 지역변수가 된다. -->
	<% int i = 0; %>
	
	<h2>멤버 메소드와 멤버 변수</h2>
	<%!
		String str = "선언 예제";
		/* 연산자 처리 메소드 생성 */
		public double cal(double num1, double num2, String op){
			double result = 0.0;
			if(op.equals("+")){
				result = num1 + num2;
			}else if(op.equals("-")){
				result = num1 - num2;
			}else if(op.equals("*")){
				result = num1 * num2;
			}else if(op.equals("/")){
				result = num1 / num2;
			}
			return result;
		}
	%>
	<h2>출력문</h2>
	<hr/>
	10+5 = <%= cal(10, 5, "+") %><br/>
	10-5 = <%= cal(10, 5, "-") %><br/>
	10*5 = <%= cal(10, 5, "*") %><br/>
	10/5 = <%= cal(10, 5, "/") %><br/>
	
	<!-- 배열 -->
	<h2>배열</h2>
	<% 
		String arr[] = {"java", "HTML", "CSS", "JavaScript"};
		for(int j = 0; j<arr.length; j++){
			/* 표현식 스크립트문법을 사용하지 않고, 브라우저로 출력하는 방법 */
			out.printf(arr[j]+"<br/>");
		}
	%>
</body>
</html>